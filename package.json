{
  "name": "builder",
  "version": "0.1.0",
  "description": "Environment graph for deployments, apps, local hosts, and cloud resources.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "teardown": "powershell -ExecutionPolicy Bypass -File scripts/teardown.ps1",
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "db:up": "node scripts/compose.mjs up -d surrealdb",
    "db:down": "node scripts/compose.mjs down --remove-orphans",
    "db:wait": "node scripts/db.mjs wait",
    "db:schema": "node scripts/db.mjs schema",
    "db:seed": "node scripts/db.mjs seed",
    "db:migrate-local": "node scripts/db.mjs migrate-local",
    "db:reset": "node scripts/db.mjs reset",
    "db:status": "node scripts/db.mjs status"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@nuxt/ui": "^4.8.1",
    "nuxt": "^4.4.6",
    "surrealdb": "^2.0.3",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.3"
  }
}
