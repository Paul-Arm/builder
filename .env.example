SURREALDB_URL=http://127.0.0.1:8000
SURREALDB_PORT=8000
SURREALDB_NAMESPACE=builder
SURREALDB_DATABASE=inventory
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# Local providers
BUILDER_LOCAL_SOURCE_ROOT=.
BUILDER_DOCKER_CONTEXT=
BUILDER_GITHUB_MAX_REPOSITORIES=100
BUILDER_GITHUB_DETAIL_REPOSITORIES=0

# OpenTofu backbone
BUILDER_OPENTOFU_BACKBONE_ENABLED=true
# Semicolon-separated JSON files exported with: tofu show -json > .data/opentofu/state.json
BUILDER_OPENTOFU_STATE_JSON_PATHS=
# Semicolon-separated plan JSON files exported with: tofu plan -out=.data/opentofu/plan.bin && tofu show -json .data/opentofu/plan.bin > .data/opentofu/plan.json
BUILDER_OPENTOFU_PLAN_JSON_PATHS=
# Semicolon-separated workspace paths. CLI execution is disabled by default because state JSON can contain sensitive values.
BUILDER_OPENTOFU_WORKSPACES=
BUILDER_OPENTOFU_CLI_ENABLED=false
BUILDER_OPENTOFU_BINARY=tofu
BUILDER_OPENTOFU_CLI_TIMEOUT_MS=15000

# DB fallback tuning
BUILDER_INVENTORY_DB_TIMEOUT_MS=1000
BUILDER_PROJECT_DB_TIMEOUT_MS=650
BUILDER_SECRET_DB_TIMEOUT_MS=650

# Required when saving provider secrets through the UI.
# Generate a local value with: openssl rand -base64 32
BUILDER_SECRET_KEY=

# Optional env fallback. Prefer the encrypted UI secret store for local use.
BUILDER_GITHUB_TOKEN=
