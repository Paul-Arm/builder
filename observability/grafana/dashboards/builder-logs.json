{
  "uid": "builder-logs",
  "title": "Builder Logs",
  "tags": ["builder", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Builder app logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"refId": "A", "expr": "{job=\"builder\"}"}
      ],
      "options": {"dedupStrategy": "none", "showLabels": true, "showTime": true, "wrapLogMessage": true},
      "gridPos": {"h": 14, "w": 16, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Docker logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"refId": "A", "expr": "{job=\"docker\"}"}
      ],
      "options": {"dedupStrategy": "none", "showLabels": true, "showTime": true, "wrapLogMessage": true},
      "gridPos": {"h": 14, "w": 8, "x": 16, "y": 0}
    }
  ]
}
