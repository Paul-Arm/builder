{
  "uid": "builder-overview",
  "title": "Builder Overview",
  "tags": ["builder", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API requests",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(builder_api_requests_total)"}
      ],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DB fallbacks",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(builder_db_fallbacks_total)"}
      ],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(builder_api_requests_total[$__rate_interval])) by (route)"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent Builder logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"refId": "A", "expr": "{job=\"builder\"}"}
      ],
      "options": {"showLabels": true, "showTime": true, "wrapLogMessage": true},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}
    }
  ]
}
